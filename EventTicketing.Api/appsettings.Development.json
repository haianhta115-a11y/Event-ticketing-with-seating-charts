{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=event_ticketing;Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379"
  },
  "BackgroundJobs": {
    "SeatHoldCleanupEnabled": false
  },
  "Email": {
    "Mode": "Pickup",
    "ActivationUrl": "http://localhost:5173/activate"
  }
}
