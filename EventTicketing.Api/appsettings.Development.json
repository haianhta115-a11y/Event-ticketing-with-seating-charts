{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${POSTGRES_CONNECTION_STRING}"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379"
  },
  "BackgroundJobs": {
    "SeatHoldCleanupEnabled": false
  },
  "Email": {
    "Mode": "Pickup",
    "ActivationUrl": "http://localhost:5173/activate"
  },
  "Orders": {
    "PaymentTimeoutMinutes": 15
  },
  "Payments": {
    "Provider": "Mock",
    "MockBaseUrl": "http://127.0.0.1:5173/mock-gateway",
    "SandboxBaseUrl": "http://127.0.0.1:5173/sandbox-gateway",
    "ReturnUrl": "http://127.0.0.1:5173/orders",
    "WebhookSecret": "mock-secret-key-payment-sprint3",
    "AllowAnonymousSandboxResult": true
  }
}
