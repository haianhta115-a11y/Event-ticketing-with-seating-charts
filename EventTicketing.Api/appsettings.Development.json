{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${POSTGRES_CONNECTION_STRING}"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379"
  },
  "BackgroundJobs": {
    "SeatHoldCleanupEnabled": false
  },
  "Email": {
    "Mode": "Pickup",
    "ActivationUrl": "http://localhost:5173/activate"
  },
  "Orders": {
    "PaymentTimeoutMinutes": 15
  }
}
